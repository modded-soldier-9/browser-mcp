{
  "name": "browser-mcp-workspace",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Browser MCP - Native Rust AI Browser Automation Bridge",
  "author": {
    "name": "Mohamed Elsheikh",
    "email": "moddedsoldier@gmail.com",
    "url": "https://github.com/modded-soldier-9"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/modded-soldier-9/browser-mcp.git"
  },
  "license": "MIT",
  "scripts": {
    "test": "cargo test",
    "build": "cargo build --release",
    "start": "cargo run",
    "install-ext": "cargo run -- install",
    "clippy": "cargo clippy --workspace --all-targets -- -D warnings",
    "lint-ext": "node scripts/build-extension.mjs",
    "check-docs": "python scripts/check-docs.py",
    "check-all": "cargo test && cargo clippy --workspace --all-targets -- -D warnings && node scripts/build-extension.mjs && python scripts/check-docs.py"
  }
}
