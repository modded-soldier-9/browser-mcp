{
  "manifest_version": 2,
  "name": "Browser MCP",
  "version": "2.0.0",
  "description": "Browser MCP: Direct, persistent AI agent bridge to your real browser session. 40 tools, rock-solid stability.",
  "permissions": [
    "tabs",
    "tabGroups",
    "cookies",
    "activeTab",
    "storage",
    "alarms",
    "notifications",
    "webNavigation",
    "debugger",
    "<all_urls>"
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_security_policy": "script-src 'self'; object-src 'self'; connect-src 'self' ws://127.0.0.1:* http://127.0.0.1:*",
  "background": {
    "scripts": [
      "background.js",
      "offscreen.js"
    ],
    "persistent": true
  },
  "browser_action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png"
    }
  }
}
